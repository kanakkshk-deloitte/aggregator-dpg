# ╔══════════════════════════════════════════════════════════╗
# ║ 1. DYNAMIC — review/update every deploy                  ║
# ╚══════════════════════════════════════════════════════════╝

# Public-facing origin. Must be a real FQDN with a public DNS A record
# pointing to this VM BEFORE `docker compose up` — Let's Encrypt HTTP-01
# challenge needs the domain to resolve and inbound :80 to be reachable.
# For pure local dev keep PUBLIC_PROTOCOL=http and PUBLIC_HOST=localhost
# (skip CERTBOT_EMAIL/USE_LOCAL_CA — the nginx service won't start without
# them, so swap to nginx:alpine for offline local work).
PUBLIC_PROTOCOL=https
PUBLIC_HOST=portal.example.com          # public FQDN — update for this VM

# ── TLS / Let's Encrypt (consumed by jonasal/nginx-certbot) ─
# Cert expiry + abuse notifications. Must be a reachable mailbox on a real
# domain — Let's Encrypt rejects @example.com and other placeholder TLDs,
# so cert issuance fails until this is set to an address you actually own.
CERTBOT_EMAIL=ops@your-domain.example          # set to a real mailbox before `docker compose up`
# 1 = self-signed via pebble (smoke-test without LE rate limits)
# 0 = real Let's Encrypt certificates (production)
USE_LOCAL_CA=0

# ── runtime toggles ─────────────────────────────────────────
LOG_LEVEL=info
COOKIE_SECURE=true                      # required when PUBLIC_PROTOCOL=https; `false` only for plain-HTTP dev
# Deployment environment. Keep `production` on a VM so the TLS guard is armed
# (api/worker refuse to boot if TLS verification is disabled in production).
INSTANCE_ENV=production
# TLS certificate verification. Leave UNSET (or `1`) on any real deploy — certs
# are verified. `0` disables ALL verification for the whole Node process and is
# refused in production by apps/*/src/config.ts. For local https OIDC against a
# self-signed pebble cert, do NOT set this here — use `make up` (it layers
# docker-compose.dev.yml, which sets it to 0 for local containers only).
# For a real internal-CA cert, point NODE_EXTRA_CA_CERTS at the CA bundle
# instead of disabling verification.
# NODE_TLS_REJECT_UNAUTHORIZED=1
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/internal-ca.pem
# Access control (docs/rbac/rbac-design-aggregator.md), one switch for the api
# and its edge (Envoy + OPA in front of it, docs/rbac/rbac-edge-enforcement.md).
# `off` (default): no checks, no edge. `log`: the api publishes its role
# catalogue to OPA_URL and keeps each user's token `roles` claim in step; the
# edge and the api's per-organisation checks record would-denies only.
# `enforce`: the edge refuses a missing route permission (the api no longer
# checks route permissions itself, so an enforcing instance MUST run the edge)
# and the api's per-organisation checks refuse. Roles live in the database;
# the built-in ones are seeded by a database migration (custom roles are added
# at runtime). Each replica re-reads roles every RBAC_CATALOGUE_REFRESH_MS (0 = never).
# RBAC_MODE=off
# OPA_URL=http://opa:8181
# RBAC_CATALOGUE_REFRESH_MS=30000
# CUSTOM-ROLES capability (network-admin role authoring). `false` (default) is
# opt-in: custom roles stay inert, the authoring routes return 404, and
# /v1/aggregator-config reports features.custom_roles=false. Subordinate to
# RBAC_MODE — with RBAC_MODE=off it has no effect.
# RBAC_CUSTOM_ROLES_ENABLED=false
# With RBAC on, the token `roles` claim (a Keycloak user attribute) is kept in
# step on every role change, plus a sweep that retries
# failed writes and expired roles (0 = off) and a full reconcile at boot and
# every RBAC_TOKEN_ROLES_RECONCILE_MS (0 = off).
# RBAC_TOKEN_ROLES_SWEEP_MS=60000
# RBAC_TOKEN_ROLES_RECONCILE_MS=86400000
# Deploy-time override for the signalstack network.json URL (#512). When set,
# it wins over `aggregator.network.source` in aggregator.config.yaml — lets a
# deployment swap the schema source (e.g. the bluedots-schemas repo, or a
# Kubernetes ConfigMap-provided URL) without rebuilding images. Must be a
# valid URL; api + worker fail boot on a malformed value. Leave blank to use
# the YAML value.
# AGGREGATOR_NETWORK_SOURCE=

# Deploy-time override for the participant consent.json URL (Terms/Privacy/
# profile-creation shown on the registration link). When set, it wins over
# `aggregator.network.consent_source` in aggregator.config.yaml. Fetched the
# same cache-backed way as network.json; a fetch failure falls back to the
# on-disk schemas/participant/consent.json copy (non-fatal). Must be a valid
# raw URL (no blob→raw normalisation). Leave blank to use the YAML value.
# AGGREGATOR_PARTICIPANT_CONSENT_SOURCE=

# ── admin / ops contacts ────────────────────────────────────
ADMIN_EMAILS=admin@example.com
# Owner of the fixed "Default" organisation that holds coordinators with no
# other org (migration 0028). Optional: when set, the API creates that person's
# account (and a disabled Keycloak user) at boot and sends Default-org
# coordinator approvals there; when unset they go to ADMIN_EMAILS. The first
# ADMIN_EMAILS entry also becomes the owner of the network root organisation.
DEFAULT_ORG_OWNER_EMAIL=
# Recipient for the in-app "Contact support" form. When unset, the form is
# hidden and POST /v1/support returns 503. Emails send via the configured
# mailer (MAIL_PROVIDER) with Reply-To set to the submitting coordinator.
# SUPPORT_EMAIL and SUPPORT_CC_EMAIL each accept multiple comma-separated
# addresses (e.g. hello@bluedotseconomy.org).
SUPPORT_EMAIL=
# Optional CC recipient(s) for the "Contact support" form. Comma-separated
# (e.g. vineela@ekstepplus.org). Leave blank to add no CC.
SUPPORT_CC_EMAIL=
# Campaign participant-PII export (#579): POST /v1/campaign/export emails a
# short-lived pre-signed S3 link to the REQUESTING AGGREGATOR (resolved from the
# token's aggregator_id -> contact_email) — there is no admin-recipient env. The
# export runs in the worker; see the export tuning + mailer (MAIL_PROVIDER) below.
# Attachment budget for the "Contact support" form: total decoded bytes across
# all files on one submission (default 5MB) and how many files may be attached
# (default 3). Served to the web form by GET /v1/support/config, so it follows
# these without a rebuild, and the route's HTTP body limit is derived from the
# byte budget. SES rejects a message over 10MB after base64 inflation, so ~7MB
# of original file is the practical ceiling whatever these say.
SUPPORT_ATTACHMENT_MAX_TOTAL_BYTES=5242880
SUPPORT_ATTACHMENT_MAX_FILES=3

# Per-domain Signals UI login URLs for the public-registration hand-off,
# comma-separated `domain=url` pairs (e.g. seeker=https://signals-seeker.
# example/auth/login,provider=https://signals-provider.example/auth/login).
# Leave blank to show no Signals hand-off on any domain.
# IMPORTANT: this must be the Signals **UI** login URL (normally
# <origin>/auth/login), never a Keycloak authorization URL — those embed
# one-time state/code_challenge values and will fail for every user but
# the one who generated the link.
# SIGNALS_UI_URLS=

# Onboarding capability allow-list (#637). Comma-separated subset of the
# network's registration modes this instance may create links for: `form`,
# `voice`. Leave commented out — the default — to enable all of them, which is
# the behaviour every deployment has today; `form,voice` means the same thing.
# Set it only to withhold a mode, e.g. UAT running profile-only onboarding:
#   AGGREGATOR_ONBOARDING_ENABLED=form
#
# LEAVE IT OUT ENTIRELY, DO NOT SET IT BLANK. `AGGREGATOR_ONBOARDING_ENABLED=`
# is a present-but-empty value: it names no capability, so it disables ALL
# onboarding (loudly — the api logs an ERROR at first config load). "Enable
# everything" means the variable is absent, not empty.
#
# `bulk` is accepted for forward-compatibility but currently gates nothing —
# it does NOT gate bulk upload, which stays available regardless of this var.
# Because it matches no declared registration mode, setting it ALONE
# (`AGGREGATOR_ONBOARDING_ENABLED=bulk`) disables all onboarding too.
#
# Creation only: registration links that already exist keep working in their
# own mode, so a printed voice QR is unaffected.

# ── postgres secrets ────────────────────────────────────────
POSTGRES_PASSWORD=aggregator-dev

# ── object storage (AWS S3, IAM role) ───────────────────────
# No access keys here — the VM's EC2 instance role must grant:
#   s3:GetObject, s3:PutObject, s3:HeadObject, s3:DeleteObject on
#   arn:aws:s3:::${S3_BUCKET}/* and s3:ListBucket on the bucket itself.
# Create the bucket once with:  aws s3 mb s3://${S3_BUCKET} --region ${S3_REGION}
S3_REGION=ap-south-1
S3_BUCKET=aggregator-bulk-uploads
# false → virtual-hosted-style URLs (AWS S3 default). Keep true only when
# pointing at a path-style endpoint (e.g. a self-hosted MinIO for local dev).
S3_FORCE_PATH_STYLE=false
# Local MinIO (dev only) is gated behind the `storage` compose profile and is
# NOT started by a plain `docker compose up` — prod uses real AWS S3 above.
# `make up` enables it. When you do run local MinIO, set your own credentials
# (never leave the world-known minioadmin default) and set S3_ENDPOINT:
# MINIO_ROOT_USER=          # openssl rand -hex 12
# MINIO_ROOT_PASSWORD=      # openssl rand -hex 24  (min 8 chars)
# S3_ENDPOINT=http://minio:9000
# Browser-reachable S3 host for pre-signed EXPORT links (the worker mints them;
# the link is clicked in a browser/email client). Falls back to S3_ENDPOINT —
# only needed when the internal endpoint isn't browser-reachable (e.g. MinIO).
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# RETENTION: the worker never deletes S3 objects (see cron-watchdog.ts). The
# campaign PII exports under the `campaign-exports/` prefix contain personal
# data and the download link is short-lived (EXPORT_URL_TTL_SECONDS) — configure
# a bucket LIFECYCLE RULE to expire objects under `campaign-exports/` (e.g. 1 day)
# alongside the existing `bulk-uploads/` rule, so decrypted CSVs don't persist.

# ── keycloak secrets ────────────────────────────────────────
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin-password

# ── SMS provider (twilio / aws sns / msg91) ─────────────────
KC_SPI_SMS_PROVIDER=log                 # `log` (dev) | `twilio` | `sns` | `msg91`
AWS_REGION=ap-south-1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MSG91 (India, DLT-compliant Flow API). Activate via KC_SPI_SMS_PROVIDER=msg91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=                      # DLT-approved Flow template id
MSG91_SENDER_ID=                        # optional override (else taken from template)
MSG91_OTP_VAR_NAME=var                  # template variable receiving the OTP code

# ── mail / smtp (shared by api + keycloak) ──────────────────
# Defaults target the in-stack Mailpit (service name `mailpit`, defined in
# local-setup/docker-compose.yml) — login OTP and review emails land in
# https://${PUBLIC_HOST}/mail/ on first boot with no extra config. To send
# real email (SES/SendGrid/Workspace SMTP), override these in this file.
# Keycloak's realm.smtpServer is rendered from these by render-realm.sh,
# so changing them takes effect on the next realm import (fresh DB) — for
# an existing realm, also patch via kcadm or the Admin Console UI.
MAIL_PROVIDER=smtp                      # `smtp` | `ses`
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@bluedots.local
SMTP_FROM_DISPLAY=Blue Dots Aggregator
SMTP_AUTH=false                         # set true when using a real SMTP relay
SMTP_STARTTLS=false                     # Mailpit has no TLS; flip true for STARTTLS relays (port 587)
SMTP_SSL=false                          # flip true for implicit TLS (port 465)
SMTP_SECURE=false                       # api-side flag; matches SMTP_SSL semantics
SMTP_USER=
SMTP_PASSWORD=
SES_FROM=
SES_CONFIGURATION_SET=

# ── api secrets ─────────────────────────────────────────────
# aggregator-api Keycloak client secret. REQUIRED — no default. render-realm.sh
# fails the Keycloak boot if unset, and apps/api throws at startup if unset.
# Generate a strong value (openssl rand -hex 32) and rotate the Keycloak client
# secret to match; NEVER reuse a committed placeholder.
KEYCLOAK_ADMIN_CLIENT_SECRET=
APPROVAL_TOKEN_SECRET=                  # openssl rand -hex 32   (≥32 chars, REQUIRED)

# ── web (portal BFF) secrets ────────────────────────────────
# aggregator-portal Keycloak client secret. REQUIRED — no default (openssl rand -hex 32).
OIDC_CLIENT_SECRET=
SESSION_KEY=                            # openssl rand -hex 32   (≥32 chars, REQUIRED)
# BFF anonymous-proxy service token (routes that hit the API on behalf of
# unauthenticated browsers, e.g. POST /api/aggregator/register). Uses the
# dedicated minimal-scope `aggregator-bff` Keycloak client — NEVER the powerful
# `aggregator-api` client. BFF_SERVICE_CLIENT_SECRET is REQUIRED (no default).
BFF_SERVICE_CLIENT_ID=aggregator-bff
BFF_SERVICE_CLIENT_SECRET=


# ╔══════════════════════════════════════════════════════════╗
# ║ 2. STATIC — internal defaults; rarely touched            ║
# ╚══════════════════════════════════════════════════════════╝

# ── postgres ────────────────────────────────────────────────
POSTGRES_USER=aggregator
POSTGRES_DB=aggregator

# ── redis (internal docker network only; no secret) ─────────
REDIS_URL=redis://redis:6379

# ── keycloak ────────────────────────────────────────────────
KC_BOOTSTRAP_ADMIN_USERNAME=admin

# ── api ─────────────────────────────────────────────────────
# Per-deployment identity value — name it after this instance's network/domain
# (e.g. bluedots, orangedots), not a fixed constant across deployments.
KEYCLOAK_REALM=bluedots
KEYCLOAK_ADMIN_CLIENT_ID=aggregator-api
# JWT client-scoping controls (#1.7). azp allow-list: only tokens whose
# `azp` (the client that requested them) is listed here are accepted — this
# stops a token minted for another realm client being replayed at the API.
# Keep in sync with the realm's clients (aggregator-portal = user tokens,
# aggregator-api/aggregator-bff = service tokens).
# NOTE: campaign-manager is deliberately NOT in this global list. It is allowed
# ONLY on the campaign-manager routes via CAMPAIGN_MANAGER_ALLOWED_AZP below, so
# a campaign-manager token is rejected by every other endpoint (least privilege,
# #579/#576).
KEYCLOAK_ALLOWED_AZP=aggregator-portal,aggregator-api,aggregator-bff
# Realm roles that mark a SIGNALS participant, comma-separated. Both apps share
# one Keycloak realm, so a token can be valid and still belong to Signals; the
# portal reads these to say "you're signed in as a Signals account" instead of
# showing org-owner copy to a seeker (#753). Must match Signals'
# KEYCLOAK_REQUIRED_REALM_ROLES, whose own default is the value below.
#
# OPTIONAL OVERRIDE — the real source is config as code:
# `aggregator.signals.realm_roles` in config/<network>[/<brand>]/aggregator.config.yaml.
# That travels with the repo's config/ tree and so reaches a deployment without
# a chart or values change; this var only exists for a local one-off or an
# incident where config cannot be re-rolled. Set here, it WINS over config.
# Neither set = fall back to a generic message, so a wrong list is never guessed.
SIGNALS_REALM_ROLES=signals_participant,signals_admin
# Keycloak client(s) (azp) allowed to call the campaign-manager routes — the PII
# export today, plus the email/voice campaign APIs that follow (same caller).
# OVERRIDES KEYCLOAK_ALLOWED_AZP on those routes (default `campaign-manager`).
CAMPAIGN_MANAGER_ALLOWED_AZP=campaign-manager
# Optional `aud` (audience) check — OPT-IN, leave blank by default. When set,
# every accepted token's `aud` must contain this value, which requires the
# audience mapper on EVERY client that calls the API — including the
# campaign-manager client. The shipped realm carries the mapper only on some
# clients, so hard-setting this can 401 the whole instance. Enable it only after
# confirming all caller clients emit the audience.
KEYCLOAK_EXPECTED_AUDIENCE=
# Bulk-upload presigned URL TTL (seconds) and size cap (bytes).
BULK_UPLOAD_URL_TTL_SECONDS=900
BULK_UPLOAD_MAX_BYTES=10485760
# Campaign PII export (#579): max item_ids per request (API), and the pre-signed
# download-link TTL (seconds, used by the worker). Default TTL is 1 day (86400);
# keep it in step with the S3 lifecycle rule that deletes the export file at
# expiry (bluedots-automation `global.campaignExportExpiryDays`) so the link and
# the file expire together.
CAMPAIGN_EXPORT_MAX_ITEMS=500
EXPORT_URL_TTL_SECONDS=86400
# CAMPAIGN_CONCURRENCY=2         # parallel campaign-process jobs per worker
# Campaign participant email (#578): recipients per request (API) and how many
# of them a single job sends in parallel (worker). The send runs in the worker's
# `campaign` role and reuses the mailer env (MAIL_PROVIDER/SMTP_*/SES_*).
CAMPAIGN_EMAIL_MAX_ITEMS=200
# EMAIL_SEND_CONCURRENCY=5             # parallel sends per email job (worker)
# ── Campaign async-job engine (#579) ──────────────────────────────────────────
# API-side ingress controls (per signalstack org). Per-channel by design —
# voice (#577) and email (#578) add their own CAMPAIGN_VOICE_*/CAMPAIGN_EMAIL_*.
CAMPAIGN_EXPORT_SUBMIT_WINDOW_SECONDS=60   # rate-limit window for export submits
CAMPAIGN_EXPORT_SUBMIT_MAX=10              # max export submits per window
CAMPAIGN_EXPORT_MAX_ACTIVE_PER_ORG=3       # max in-flight (queued|processing) export jobs
CAMPAIGN_EXPORT_ATTEMPTS=3             # BullMQ retry attempts per campaign-process job
# ── Campaign voice channel (#577) ──────────────────────────────────────────
# Raya voice provider configuration. RAYA_API_KEY is optional and asserted
# lazily when the voice campaign job runs (asserts CAMPAIGN_VOICE_PROVIDER=raya).
CAMPAIGN_VOICE_PROVIDER=raya
CAMPAIGN_VOICE_MAX_ITEMS=500               # max participant_ids per voice request
CAMPAIGN_VOICE_SUBMIT_WINDOW_SECONDS=60    # rate-limit window for voice submits
CAMPAIGN_VOICE_SUBMIT_MAX=10               # max voice submits per window
CAMPAIGN_VOICE_MAX_ACTIVE_PER_ORG=3        # max in-flight voice campaign jobs
CAMPAIGN_VOICE_ATTEMPTS=3                  # BullMQ retry attempts per voice job
RAYA_BASE_URL=https://v1.getraya.app/api
# RAYA_API_KEY=                             # set when using the Raya provider
RAYA_TIMEOUT_MS=15000                      # HTTP timeout for Raya calls (ms)
RAYA_EGRESS_WINDOW_SECONDS=20              # rate-limit window for Raya calls
RAYA_EGRESS_MAX=1                          # max Raya calls per window
CAMPAIGN_EMAIL_SUBMIT_WINDOW_SECONDS=60    # rate-limit window for email submits
CAMPAIGN_EMAIL_SUBMIT_MAX=10               # max email submits per window
CAMPAIGN_EMAIL_MAX_ACTIVE_PER_ORG=3        # max in-flight (queued|processing) email jobs
# BullMQ retry attempts per email job. Safe at 3: the worker's per-item
# terminal-status guard means a retry never re-emails an item already `sent`.
CAMPAIGN_EMAIL_ATTEMPTS=3
# Worker-side processing controls:
CAMPAIGN_DECRYPT_CHUNK=500             # items per Signals decrypt chunk + heartbeat cadence
CAMPAIGN_EXPORT_FIELDS=contact         # contact = name/email/phone only; full = whole item_state
CAMPAIGN_STALL_SECONDS=900             # a processing job idle this long is failed:stalled by the watchdog
# CAMPAIGN_EXPORT_RECIPIENT=requester  # requester (default) | network_admin
# EXPORT_NETWORK_ADMIN_EMAIL=          # recipient when CAMPAIGN_EXPORT_RECIPIENT=network_admin
# Lifetime of admin approval/rejection links (seconds). Drives both the
# signed-token expiry and the "expires in …" wording on the admin email +
# confirmation page. Default 7 days (604800).
APPROVAL_TOKEN_TTL_SECONDS=604800
# Base URL embedded in registration-link QR codes shown to participants.
# Defaults to ${PUBLIC_PROTOCOL}://${PUBLIC_HOST} when unset.
PUBLIC_LINK_BASE_URL=
# (ORG_HIERARCHY_ENABLED was removed in migration 0028: organisations are always
# on. Remove it from existing env files; the API logs a warning while it is set.)
# ALLOW_TRAIN_ON_BOOT — dev / e2e ONLY; leave unset here. The API refuses to
# apply the user & org instance upgrade (migrations 0023+) at boot on a database
# that holds data; deployed instances apply it with the instance-upgrade tool
# (docs/plans/existing-instance-migration.md), pods at zero.
# Serve the OpenAPI spec + Scalar reference UI at /api/reference. Default-on
# in dev for convenience. Force-disabled whenever NODE_ENV=production unless
# API_REFERENCE_FORCE is also set — production deploys should set
# NODE_ENV=production and may additionally set API_REFERENCE_ENABLED=false
# here for defense in depth.
API_REFERENCE_ENABLED=true
# Escape hatch to serve the docs surface even under production. Off by
# default — only set to `true` if you deliberately want the enumerable
# route map exposed in production.
API_REFERENCE_FORCE=false

# ── worker (BullMQ consumer + cron) ────────────────────────
BULK_MAX_ROWS=10000
BULK_MAX_ROW_BYTES=65536
LINK_METRICS_ROLLUP_INTERVAL_MS=300000
WATCHDOG_INTERVAL_MS=3600000

# ── web (portal BFF) ────────────────────────────────────────
API_BASE_URL=http://envoy:4000            # docker-network DNS; not browser-visible
# Switchable UI languages, comma-separated and ordered; `en` is always included.
# Leave blank for all supported languages (en,kn,hi). `en,hi` drops Kannada;
# `en` alone hides the switcher. Read per request, so a restart applies it —
# the web image needs no rebuild for this.
ENABLED_LANGUAGES=
# Max coordinators an org owner can invite per submission. Blank → 10.
# Keep in step with the api's INVITE_MINT_MAX_RECIPIENTS.
INVITE_MAX_RECIPIENTS=
# Google Maps BROWSER key for the registration form's address autocomplete.
# Blank → the key-less Photon geocoder, so the field still works. The key needs
# BOTH Maps JavaScript API and Places API (New) enabled — a Places-only API
# restriction blocks the loader script itself — and should be HTTP-referrer
# restricted to this deployment's own host.
GOOGLE_MAPS_API_KEY=
# Which state's college/institute list backs the reference-autocomplete field:
# `ka` | `up`. Blank → `ka`. Must name a dataset the deployment actually serves
# (see REFERENCE_BASE_URL) — asking for one it doesn't have leaves the field a
# plain text input.
COLLEGE_DATASET=
# Where the reference datasets are fetched from by the browser. Blank → this
# app's own `/reference/`, which is where a deployment mounts its ConfigMap.
#
# The datasets are NOT committed to this repo — they are large, they are always
# shadowed by that ConfigMap in a real deployment, and a committed copy cannot
# stay in step with canonical. For LOCAL DEV, point this at canonical directly;
# raw.githubusercontent.com sends `access-control-allow-origin: *`, so the
# browser can fetch it:
#   REFERENCE_BASE_URL=https://raw.githubusercontent.com/Blue-Dots-Economy/bluedots-schemas/main/apps/ui/public/reference/
# Leave blank and the institute field is simply a text box, which is a valid way
# to run locally if you are not working on that field.
REFERENCE_BASE_URL=
# Override for the key-less fallback geocoder. Blank → Photon's public host.
PHOTON_URL=
# ISO 3166-1 alpha-2 country the address autocomplete is restricted to, e.g. IN
# (signals-dpg#785). Blank → suggestions from anywhere.
GEO_COUNTRY=
OIDC_CLIENT_ID=aggregator-portal
OIDC_SCOPE=openid profile email
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=43200
