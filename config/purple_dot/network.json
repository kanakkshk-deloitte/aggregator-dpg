            },
            "provider_category": {
              "vectorize": true,
              "type": "string",
              "title": "Category",
              "description": "Select the category that applies to you",
              "enum": [
                "NGO / Trust",
                "Government Body",
                "Private Company",
                "Community Group",
                "Private Individual Practice",
                "Hospital / Clinic",
                "Educational Institution",
                "Professional Network",
                "Digital Platform"
              ]
            },
            "service_provider_name": {
              "type": "string",
              "title": "Service Provider Name",
              "description": "Name of your organisation (or your name if individual)",
              "minLength": 1,
              "vectorize": true
            },
            "disabilities_served": {
              "vectorize": true,
              "vector_weight": 2,
              "type": "array",
              "title": "Disabilities Served",
              "description": "What type of seekers are you looking for?",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "Acid Attack Victim",
                  "Autism Spectrum Disorder",
                  "Blindness",
                  "Cerebral Palsy",
                  "Dwarfism",
                  "Hearing Impairment",
                  "Hemophilia",
                  "Intellectual Disability",
                  "Leprosy Cured",
                  "Locomotor Disability",
                  "Low Vision",
                  "Mental Illness",
                  "Multiple Sclerosis",
                  "Muscular Dystrophy",
                  "Parkinson's Disease",
                  "Sickle Cell Anaemia",
                  "Specific Learning Disabilities",
                  "Speech and Language Disability",
                  "Thalassemia",
                  "Chronic Neurological Conditions",
                  "Multiple Disabilities including deaf-blindness"
                ]
              }
            },
            "support_services": {
              "type": "array",
              "title": "Services Offered",
              "description": "What services or support do you provide?",
              "vectorize": true,
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "Assistive Devices",
                  "Health & Rehabilitation",
                  "Training & Skill Building",
                  "Scheme Application Support",
                  "Counselling & Mentorship",
                  "Accessibility Support",
                  "Employment Opportunities",
                  "Scholarships",
                  "Financial Products (Loans/Insurance)",
                  "Education",
                  "Screening",
                  "Pension",
                  "Documentation Support",
                  "Community Support",
                  "Other"
                ]
              }
            },
            "operating_cities": {
              "type": "array",
              "title": "Operating Cities",
              "description": "Cities where seekers can access your services",
              "location": "primary",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "office_address": {
              "type": "string",
              "title": "Organisation Address",
              "description": "Your organisation's office or headquarters address",
              "minLength": 1,
              "location": "secondary"
            },
            "offering_details": {
              "type": "string",
              "title": "Service Details",
              "description": "Share more about the service, opportunity, or support provided",
              "vectorize": true,
              "vector_weight": 2,
              "minLength": 1
            },
            "catalog_url": {
              "type": "string",
              "title": "Catalog URL",
              "description": "URL to a catalog or service list you provide",
              "format": "uri"
            }
          }
        }
      },
      "id": "service_provider",
      "card": {
        "title_field": "service_provider_name",
        "avatar_from": "service_provider_name",
        "default_fields": [
