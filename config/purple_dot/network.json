{
  "display_name": "Purple Dot",
  "description": "Discovery and services network for People with Disabilities.",
  "schema_standard": "https://json-schema.org/draft/2020-12/schema",
  "domains": [
    {
      "description": "Persons with disabilities seeking jobs, training, healthcare, government schemes, and community support.",
      "minimum_cache_ttl_seconds": 300,
      "status_rules": [
        {
          "status": "new",
          "label": "New",
          "description": "Joined within the last 7 days",
          "when": {
            "item_age_days": {
              "lte": 7
            }
          }
        },
        {
          "status": "active",
          "label": "Active",
          "description": "Connected with a service provider in the last 30 days",
          "when": {
            "days_since_last": {
              "buckets": ["create", "accept"],
              "lte": 30
            }
          }
        },
        {
          "status": "at_risk",
          "label": "At Risk",
          "description": "No activity for 30–90 days",
          "when": {
            "days_since_last": {
              "buckets": ["create", "accept", "reject"],
              "between": [31, 90]
            }
          }
        },
        {
          "status": "inactive",
          "label": "Inactive",
          "description": "No activity 90+ days",
          "when": "default"
        }
      ],
      "item_schemas": {
        "profile_1.0": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Person with Disability Profile 1.0",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "person_name",
            "mobile_number",
            "age",
            "gender",
            "disability_type",
            "disability_percentage",
            "support_needed",
            "support_details",
            "documents_available",
            "primary_address"
          ],
          "properties": {
            "person_name": {
              "type": "string",
              "title": "Name",
              "minLength": 1,
              "private": true
            },
            "mobile_number": {
              "type": "string",
              "title": "Mobile",
              "pattern": "^(?:\\+91[-\\s]?)?[0-9]{10}$",
              "private": true
            },
            "email": {
              "type": "string",
              "title": "Email",
              "format": "email",
              "private": true
            },
            "age": {
              "type": "integer",
              "title": "Age",
              "minimum": 0,
              "maximum": 120
            },
            "gender": {
              "type": "string",
              "title": "Gender",
              "enum": ["Male", "Female", "Other", "Prefer not to say"]
            },
            "disability_type": {
              "vectorize": true,
              "vector_weight": 2,
              "type": "array",
              "title": "Disability",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "Acid Attack Victim",
                  "Autism Spectrum Disorder",
                  "Blindness",
                  "Cerebral Palsy",
                  "Dwarfism",
                  "Hearing Impairment",
                  "Hemophilia",
                  "Intellectual Disability",
                  "Leprosy Cured",
                  "Locomotor Disability",
                  "Low Vision",
                  "Mental Illness",
                  "Multiple Sclerosis",
                  "Muscular Dystrophy",
                  "Parkinson's Disease",
                  "Sickle Cell Anaemia",
                  "Specific Learning Disabilities",
                  "Speech and Language Disability",
                  "Thalassemia",
                  "Chronic Neurological Conditions",
                  "Multiple Disabilities including deaf-blindness"
                ]
              }
            },
            "disability_percentage": {
              "type": "integer",
              "title": "Disability %",
              "minimum": 0,
              "maximum": 100
            },
            "support_needed": {
              "type": "array",
              "title": "Support Needed",
              "description": "What are you looking for?",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "Jobs",
                  "Assistive Devices",
                  "Health & Rehabilitation",
                  "Training & Skill Building",
                  "Scheme Application Support",
                  "Counselling & Mentorship",
                  "Accessibility Support",
                  "Employment Opportunities",
                  "Scholarships",
                  "Financial Products (Loans/Insurance)",
                  "Education",
                  "Screening",
                  "Pension",
                  "Documentation Support",
                  "Community Support",
                  "Other"
                ]
              },
              "vectorize": true
            },
            "support_details": {
              "type": "string",
              "title": "Details",
              "description": "Explain your choice in more detail",
              "minLength": 1,
              "vectorize": true,
              "vector_weight": 2
            },
            "primary_address": {
              "type": "string",
              "title": "Address",
              "description": "Full address — house/flat, street, area, city, state, and pincode",
              "minLength": 1,
              "private": true,
              "location": "primary"
            },
            "documents_available": {
              "type": "array",
              "title": "Documents",
              "description": "Which documents do you have?",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "Aadhaar",
                  "Income Certificate",
                  "Disability Certificate",
                  "School ID",
                  "Bank Account",
                  "Other"
                ]
              }
            },
            "highest_qualification": {
              "vectorize": true,
              "type": "string",
              "title": "Qualification",
              "description": "Highest qualification",
              "enum": [
                "10th Pass",
                "12th Pass",
                "Diploma Pass",
                "ITI Graduate",
                "College Graduate",
                "Post Graduate",
                "None of the above"
              ]
            }
          }
        }
      },
      "id": "person_with_disability",
      "card": {
        "title_field": "person_name",
        "avatar_from": "person_name",
        "default_fields": ["disability_type", "support_needed", "highest_qualification"]
      },
      "dashboard_tiles": {
        "profile": [
          {
            "field": "total_items",
            "label": "Profiles Registered"
          },
          {
            "field": "complete_profiles",
            "label": "Profiles Complete"
          },
          {
            "field": "has_applications",
            "label": "Made Connections"
          }
        ],
        "user": [
          {
            "field": "total_users",
            "label": "Total Persons with Disabilities"
          },
          {
            "field": "avg_items_per_user",
            "label": "Avg Profiles per User"
          },
          {
            "field": "avg_actions_per_user",
            "label": "Avg Actions per User"
          }
        ]
      }
    },
    {
      "description": "Organisations and individuals providing services, devices, training, or other support for persons with disabilities.",
      "minimum_cache_ttl_seconds": 300,
      "status_rules": [
        {
          "status": "new",
          "label": "New",
          "description": "Service posted within the last 7 days",
          "when": {
            "item_age_days": {
              "lte": 7
            }
          }
        },
        {
          "status": "active",
          "label": "Active",
          "description": "Accepted or rejected a request in the last 30 days",
          "when": {
            "all": [
              {
                "count": {
                  "buckets": ["create"],
                  "gt": 0
                }
              },
              {
                "days_since_last": {
                  "buckets": ["accept", "reject"],
                  "lte": 30
                }
              }
            ]
          }
        },
        {
          "status": "at_risk",
          "label": "At Risk",
          "description": "No responses for 30–90 days",
          "when": {
            "all": [
              {
                "count": {
                  "buckets": ["create"],
                  "gt": 0
                }
              },
              {
                "days_since_last": {
                  "buckets": ["accept", "reject"],
                  "between": [31, 90]
                }
              }
            ]
          }
        },
        {
          "status": "inactive",
          "label": "Inactive",
          "description": "No activity for 90+ days",
          "when": "default"
        }
      ],
      "item_schemas": {
        "profile_1.0": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Service Provider Profile 1.0",
